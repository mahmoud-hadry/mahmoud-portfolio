  "homepage": "https://mahmoud-hadry.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoud-hadry/mahmoud-hadry.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/mahmoud-hadry/mahmoud-hadry.github.io/issues"
  },
