  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-emoji": "^1.8.1",
    "react-headroom": "^3.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "check-format": "prettier --check \"{src,public,index.html,*.md,*.json}/**/*.{js,jsx,json,css,scss,html,md}\" \"*.{js,json,md,html}\"",
    "format": "prettier --write \"{src,public}/**/*.{js,jsx,json,css,scss,html,md}\" \"*.{js,json,md,html}\"",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
